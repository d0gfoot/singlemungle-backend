SPRING_PROFILES_ACTIVE=local

API_TOKEN=change-me

JWT_SECRET=singlemungle-local-development-secret-key-change-me
JWT_ACCESS_TOKEN_VALIDITY_SECONDS=3600
JWT_REFRESH_TOKEN_VALIDITY_SECONDS=1209600

KAKAO_REST_API_KEY=
PLACE_IMPORT_CENTER_LATITUDE=37.5006000
PLACE_IMPORT_CENTER_LONGITUDE=126.8677000
PLACE_IMPORT_RADIUS_METERS=1000

VERTEX_AI_ENABLED=false
VERTEX_AI_PROJECT_ID=
VERTEX_AI_LOCATION=us-central1
VERTEX_AI_IMAGE_MODEL=gemini-3.1-flash-lite-image
VERTEX_AI_TIMEOUT_SECONDS=30
# Optional when not using `gcloud auth application-default login`.
GOOGLE_APPLICATION_CREDENTIALS=

GOOGLE_PLACES_ENABLED=false
GOOGLE_PLACES_API_KEY=
GOOGLE_PLACES_LANGUAGE_CODE=ko
GOOGLE_PLACES_REGION_CODE=KR
GOOGLE_PLACES_TIMEOUT_SECONDS=5
GOOGLE_PLACES_CENTER_LATITUDE=37.5000530744517
GOOGLE_PLACES_CENTER_LONGITUDE=126.86799268384159
GOOGLE_PLACES_DEFAULT_RADIUS_METERS=10000
GOOGLE_PLACES_MAX_RADIUS_METERS=10000
GOOGLE_PLACES_MAX_RESULTS=20
GOOGLE_PLACES_BEAUTY_SEARCH_QUERY=dog grooming

IMAGE_STORAGE_TEMP_DIRECTORY=build/temp-images
IMAGE_STORAGE_TEMP_CLEANUP_CRON=0 30 * * * *
IMAGE_STORAGE_TEMP_RETENTION_HOURS=24
IMAGE_STORAGE_CLEANUP_ENABLED=true
IMAGE_STORAGE_CLEANUP_CRON=0 0 4 * * *
IMAGE_STORAGE_PENDING_CLEANUP_CRON=0 * * * * *
IMAGE_STORAGE_PENDING_TIMEOUT_MINUTES=10

IMAGE_STORAGE_DIRECTORY=build/generated-images
IMAGE_STORAGE_BASE_URL=/api/v1/beauty/style-simulations/images

DB_HOST=localhost
DB_PORT=5432
DB_NAME=singlemungle
DB_USERNAME=singlemungle
DB_PASSWORD=singlemungle

# DB_URL can be used instead of DB_HOST, DB_PORT, and DB_NAME.
# DB_URL=jdbc:postgresql://localhost:5432/singlemungle

POSTGRES_IMAGE=postgres:16
POSTGRES_CONTAINER_NAME=singlemungle-postgres
POSTGRES_VOLUME_NAME=singlemungle-postgres-data
DB_LOCALE=en_US.utf8

JPA_DDL_AUTO=validate
JPA_SHOW_SQL=true
JPA_FORMAT_SQL=true
FLYWAY_ENABLED=true

SWAGGER_ENABLED=true

LOG_LEVEL_ROOT=INFO
LOG_LEVEL_APP=DEBUG
LOG_FILE_NAME=logs/singlemungle.log
REQUEST_LOGGING_ENABLED=true
